[run]
core = sysmon

[paths]
source =
    auto_round
    */_work/*/s/auto_round
    */auto-round/auto_round
    */site-packages/auto_round/

[report]
include =
 */auto_round/**
 */auto_round_extension/**
omit =
 */auto_round/export/export_to_gguf/conversion/*
 */auto_round/export/export_to_gguf/sync_llama_cpp_conversion.py
 */auto_round/algorithms/transforms/hadamard/utils/triton/*
 */auto_round/modeling/finegrained_fp8_patch*.py
exclude_lines =
 pragma: no cover
 raise NotImplementedError
 raise TypeError
 except ImportError:
 except Exception as e:
