namespace ark {

void sycl_tla_moe_decode_@DECODE_INT_KIND@(const MoeDecodeParams& params) {
  if (params.act_dtype == BTLA_DTYPE::F16) {
    if (params.asym) {
      moe_decode_detail::launch_@DECODE_INT_KIND@<sycl::half, true>(
          params.q, static_cast<const sycl::half*>(params.activations), static_cast<const uint8_t*>(params.weights),
          static_cast<const sycl::half*>(params.scales), static_cast<const sycl::half*>(params.zeros),
          static_cast<sycl::half*>(params.outputs), params.expert_id_per_token, params.total_tokens, params.N,
          params.K, params.group_size);
    } else {
      moe_decode_detail::launch_@DECODE_INT_KIND@<sycl::half, false>(
          params.q, static_cast<const sycl::half*>(params.activations), static_cast<const uint8_t*>(params.weights),
          static_cast<const sycl::half*>(params.scales), static_cast<const sycl::half*>(params.zeros),
          static_cast<sycl::half*>(params.outputs), params.expert_id_per_token, params.total_tokens, params.N,
          params.K, params.group_size);
    }
    return;
  }
  if (params.act_dtype == BTLA_DTYPE::BF16) {
    using BF = sycl::ext::oneapi::bfloat16;
    if (params.asym) {
      moe_decode_detail::launch_@DECODE_INT_KIND@<BF, true>(
          params.q, static_cast<const BF*>(params.activations), static_cast<const uint8_t*>(params.weights),
          static_cast<const BF*>(params.scales), static_cast<const BF*>(params.zeros), static_cast<BF*>(params.outputs),
          params.expert_id_per_token, params.total_tokens, params.N, params.K, params.group_size);
    } else {
      moe_decode_detail::launch_@DECODE_INT_KIND@<BF, false>(
          params.q, static_cast<const BF*>(params.activations), static_cast<const uint8_t*>(params.weights),
          static_cast<const BF*>(params.scales), static_cast<const BF*>(params.zeros), static_cast<BF*>(params.outputs),
          params.expert_id_per_token, params.total_tokens, params.N, params.K, params.group_size);
    }
    return;
  }
  throw std::invalid_argument("moe_gemm_decode(@DECODE_INT_KIND@): act_dtype must be FP16 or BF16");
}

