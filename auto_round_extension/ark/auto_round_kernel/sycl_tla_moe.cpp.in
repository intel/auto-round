void sycl_tla_moe_decode_fill_expert_id(sycl::queue* q, int* expert_id_per_token,
                                        const int* num_tokens_per_expert, int num_experts, int total_tokens) {
  if (total_tokens == 0) return;
  q->parallel_for(sycl::range<1>(static_cast<size_t>(total_tokens)), [=](sycl::id<1> idx) {
    const int token = static_cast<int>(idx[0]);
    int offset = 0;
    int expert = num_experts - 1;
    for (int expert_id = 0; expert_id < num_experts; ++expert_id) {
      const int token_count = num_tokens_per_expert[expert_id];
      if (token < offset + token_count) {
        expert = expert_id;
        break;
      }
      offset += token_count;
    }
    expert_id_per_token[token] = expert;
  });
}

