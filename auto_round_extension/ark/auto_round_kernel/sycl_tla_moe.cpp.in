      params.group_size, params.total_tokens);
}

}  // namespace @MOE_NAMESPACE@
}  // namespace ark

#elif @MOE_SOURCE_MODE@ == 11

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_mixed.hpp"

namespace ark {

void sycl_tla_moe_prefill_dequant_@MOE_DEQUANT_DTYPE@(const MoePrefillParams& params) {
  using ScalarT = @MOE_DEQUANT_SCALAR@;
  auto* weights_kn = static_cast<ScalarT*>(params.dequant_workspace);
  moe_mixed_detail::dequant_to_KN<ScalarT>(
      params.q, params.weights, params.scales, params.zeros, weights_kn, params.weight_dtype, params.num_experts,
      params.N, params.K, params.group_size, params.asym, params.num_tokens_per_expert);
  moe_gemm(params.q, params.activations, weights_kn, nullptr, params.outputs, params.act_dtype, params.N, params.K,
           params.num_tokens_per_expert, params.num_experts);
}

