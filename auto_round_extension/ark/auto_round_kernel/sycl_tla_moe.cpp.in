#elif @MOE_SOURCE_MODE@ == 7

#include "sycl_tla_common.hpp"

namespace ark {

void moe_gemm_prefill(sycl::queue* q, void* activations, void* weights, void* scales, void* zeros, void* outputs,
                      void* dequant_workspace, BTLA_DTYPE act_dtype, BTLA_DTYPE weight_dtype, int N, int K,
                      int group_size, int* num_tokens_per_expert, int num_experts, int total_tokens, bool asym) {
  if (total_tokens == 0) return;

  if (weight_dtype == act_dtype && weight_dtype == BTLA_DTYPE::F16) {
    sycl_tla_moe_gemm_f16(q, activations, weights, scales, outputs, N, K, num_tokens_per_expert, num_experts);
    return;
  }
  if (weight_dtype == act_dtype && weight_dtype == BTLA_DTYPE::BF16) {
    sycl_tla_moe_gemm_bf16(q, activations, weights, scales, outputs, N, K, num_tokens_per_expert, num_experts);
    return;
  }

  MoePrefillParams params{q, activations, weights, scales, zeros, outputs, dequant_workspace, act_dtype, weight_dtype,
                          N, K, group_size, num_tokens_per_expert, num_experts, total_tokens, asym};

  if (sycl_tla_moe_prefill_int8_dpas(params)) return;
  if (sycl_tla_moe_prefill_s4_dpas(params)) return;
  if (sycl_tla_moe_prefill_lowbit_int8_dpas(params)) return;
  if (sycl_tla_moe_prefill_fp8_dpas(params)) return;
  if (sycl_tla_moe_prefill_native_fp8(params)) return;

  if (dequant_workspace == nullptr) {
    throw std::invalid_argument("moe_gemm_prefill: dequant_workspace must be non-null for quantized paths");
  }
  if (act_dtype == BTLA_DTYPE::F16) {
    sycl_tla_moe_prefill_dequant_f16(params);
    return;
  }
  if (act_dtype == BTLA_DTYPE::BF16) {
    sycl_tla_moe_prefill_dequant_bf16(params);
    return;
  }
  throw std::invalid_argument("moe_gemm_prefill: act_dtype must be F16 or BF16");
}

}  // namespace ark

