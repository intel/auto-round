#elif @MOE_SOURCE_MODE@ == 12

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_prefill_fp8_helpers.hpp"

namespace ark {

bool sycl_tla_moe_prefill_fp8_dpas(const MoePrefillParams& params) {
  if ((params.weight_dtype != BTLA_DTYPE::F8_E4M3 && params.weight_dtype != BTLA_DTYPE::F8_E5M2) || params.asym ||
      !moe_prefill_fp8_detail::enabled() ||
      !moe_prefill_fp8_detail::shape_ok(params.N, params.K, params.group_size)) {
    return false;
  }
  const bool is_e4m3 = params.weight_dtype == BTLA_DTYPE::F8_E4M3;
  const int average_tokens = params.num_experts > 0 ? params.total_tokens / params.num_experts : 0;
  if (params.act_dtype == BTLA_DTYPE::F16) {
    if (is_e4m3) {
      if (average_tokens <= 8) moe_prefill_fp8_detail::dispatch_f16_e4m3_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_detail::dispatch_f16_e4m3_mid(params);
      else moe_prefill_fp8_detail::dispatch_f16_e4m3_large(params);
    } else {
      if (average_tokens <= 8) moe_prefill_fp8_detail::dispatch_f16_e5m2_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_detail::dispatch_f16_e5m2_mid(params);
      else moe_prefill_fp8_detail::dispatch_f16_e5m2_large(params);
    }
    return true;
  }
  if (params.act_dtype == BTLA_DTYPE::BF16) {
    if (is_e4m3) {
      if (average_tokens <= 8) moe_prefill_fp8_detail::dispatch_bf16_e4m3_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_detail::dispatch_bf16_e4m3_mid(params);
      else moe_prefill_fp8_detail::dispatch_bf16_e4m3_large(params);
    } else {
      if (average_tokens <= 8) moe_prefill_fp8_detail::dispatch_bf16_e5m2_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_detail::dispatch_bf16_e5m2_mid(params);
      else moe_prefill_fp8_detail::dispatch_bf16_e5m2_large(params);
    }
    return true;
  }
  return false;
}

}  // namespace ark

