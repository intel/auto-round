#elif @MOE_SOURCE_MODE@ == 12

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_prefill_fp8_helpers.hpp"

namespace ark {

bool sycl_tla_moe_prefill_fp8_dpas(const MoePrefillParams& params) {
  if ((params.weight_dtype != BTLA_DTYPE::F8_E4M3 && params.weight_dtype != BTLA_DTYPE::F8_E5M2) || params.asym ||
      !moe_prefill_fp8_detail::enabled() ||
      !moe_prefill_fp8_detail::shape_ok(params.N, params.K, params.group_size)) {
    return false;
  }
  const bool is_e4m3 = params.weight_dtype == BTLA_DTYPE::F8_E4M3;
  const int average_tokens = params.num_experts > 0 ? params.total_tokens / params.num_experts : 0;
  if (params.act_dtype == BTLA_DTYPE::F16) {
    if (is_e4m3) {
      if (average_tokens <= 8) moe_prefill_fp8_detail::dispatch_f16_e4m3_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_detail::dispatch_f16_e4m3_mid(params);
      else moe_prefill_fp8_detail::dispatch_f16_e4m3_large(params);
    } else {
      if (average_tokens <= 8) moe_prefill_fp8_detail::dispatch_f16_e5m2_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_detail::dispatch_f16_e5m2_mid(params);
      else moe_prefill_fp8_detail::dispatch_f16_e5m2_large(params);
    }
    return true;
  }
  if (params.act_dtype == BTLA_DTYPE::BF16) {
    if (is_e4m3) {
      if (average_tokens <= 8) moe_prefill_fp8_detail::dispatch_bf16_e4m3_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_detail::dispatch_bf16_e4m3_mid(params);
      else moe_prefill_fp8_detail::dispatch_bf16_e4m3_large(params);
    } else {
      if (average_tokens <= 8) moe_prefill_fp8_detail::dispatch_bf16_e5m2_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_detail::dispatch_bf16_e5m2_mid(params);
      else moe_prefill_fp8_detail::dispatch_bf16_e5m2_large(params);
    }
    return true;
  }
  return false;
}

}  // namespace ark

#elif @MOE_SOURCE_MODE@ == 13

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_prefill_fp8_tensor_helpers.hpp"

namespace ark {

void moe_gemm_prefill_fp8_dpas(sycl::queue* q, void* activations, void* weights, void* scales, void* outputs,
                               BTLA_DTYPE act_dtype, BTLA_DTYPE weight_dtype, int N, int K,
                               int* num_tokens_per_expert, int num_experts, int total_tokens) {
  if (total_tokens == 0) return;
  if (weight_dtype != BTLA_DTYPE::F8_E4M3 && weight_dtype != BTLA_DTYPE::F8_E5M2) {
    throw std::invalid_argument("moe_gemm_prefill_fp8_dpas: weight_dtype must be F8_E4M3 or F8_E5M2");
  }
  MoePrefillParams params{q, activations, weights, scales, nullptr, outputs, nullptr, act_dtype, weight_dtype, N, K,
                          0, num_tokens_per_expert, num_experts, total_tokens, false};
  const int average_tokens = num_experts > 0 ? total_tokens / num_experts : 0;
  const bool is_e4m3 = weight_dtype == BTLA_DTYPE::F8_E4M3;
  if (act_dtype == BTLA_DTYPE::F16) {
    if (is_e4m3) {
      if (average_tokens <= 8) moe_prefill_fp8_tensor_detail::dispatch_f16_e4m3_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_tensor_detail::dispatch_f16_e4m3_mid(params);
      else moe_prefill_fp8_tensor_detail::dispatch_f16_e4m3_large(params);
    } else {
      if (average_tokens <= 8) moe_prefill_fp8_tensor_detail::dispatch_f16_e5m2_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_tensor_detail::dispatch_f16_e5m2_mid(params);
      else moe_prefill_fp8_tensor_detail::dispatch_f16_e5m2_large(params);
    }
    return;
  }
  if (act_dtype == BTLA_DTYPE::BF16) {
    if (is_e4m3) {
      if (average_tokens <= 8) moe_prefill_fp8_tensor_detail::dispatch_bf16_e4m3_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_tensor_detail::dispatch_bf16_e4m3_mid(params);
      else moe_prefill_fp8_tensor_detail::dispatch_bf16_e4m3_large(params);
    } else {
      if (average_tokens <= 8) moe_prefill_fp8_tensor_detail::dispatch_bf16_e5m2_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_tensor_detail::dispatch_bf16_e5m2_mid(params);
      else moe_prefill_fp8_tensor_detail::dispatch_bf16_e5m2_large(params);
    }
    return;
  }
  throw std::invalid_argument("moe_gemm_prefill_fp8_dpas: act_dtype must be F16 or BF16");
}

}  // namespace ark

#elif @MOE_SOURCE_MODE@ == 14

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_prefill_int8_helpers.hpp"

namespace ark {

bool sycl_tla_moe_prefill_int8_dpas(const MoePrefillParams& params) {
  if (params.weight_dtype == BTLA_DTYPE::S8 && !params.asym &&
      moe_prefill_int8_detail::enabled() &&
      moe_prefill_int8_detail::shape_ok(params.N, params.K, params.group_size)) {
    const int average_tokens = params.num_experts > 0 ? params.total_tokens / params.num_experts : 0;
    if (params.act_dtype == BTLA_DTYPE::F16) {
      if (average_tokens <= 8) moe_prefill_int8_detail::dispatch_f16_small(params);
      else if (average_tokens <= 32) moe_prefill_int8_detail::dispatch_f16_mid(params);
      else moe_prefill_int8_detail::dispatch_f16_large(params);
      return true;
    }
    if (params.act_dtype == BTLA_DTYPE::BF16) {
      if (average_tokens <= 8) moe_prefill_int8_detail::dispatch_bf16_small(params);
      else if (average_tokens <= 32) moe_prefill_int8_detail::dispatch_bf16_mid(params);
      else moe_prefill_int8_detail::dispatch_bf16_large(params);
      return true;
    }
  }
  return false;
}

bool sycl_tla_moe_prefill_lowbit_int8_dpas(const MoePrefillParams& params) {
  if ((params.weight_dtype != BTLA_DTYPE::S4_CLIP && params.weight_dtype != BTLA_DTYPE::S2_CLIP) || params.asym ||
      !moe_prefill_int8_detail::enabled() ||
      !moe_prefill_int8_detail::shape_ok(params.N, params.K, params.group_size) ||
      params.dequant_workspace == nullptr ||
      (params.act_dtype != BTLA_DTYPE::F16 && params.act_dtype != BTLA_DTYPE::BF16)) {
    return false;
  }
  if (params.act_dtype == BTLA_DTYPE::F16) {
    const int average_tokens = params.num_experts > 0 ? params.total_tokens / params.num_experts : 0;
    if (average_tokens <= 8) moe_prefill_int8_detail::dispatch_lowbit_f16_small(params);
    else if (average_tokens <= 32) moe_prefill_int8_detail::dispatch_lowbit_f16_mid(params);
    else moe_prefill_int8_detail::dispatch_lowbit_f16_large(params);
  } else {
    const int average_tokens = params.num_experts > 0 ? params.total_tokens / params.num_experts : 0;
    if (average_tokens <= 8) moe_prefill_int8_detail::dispatch_lowbit_bf16_small(params);
    else if (average_tokens <= 32) moe_prefill_int8_detail::dispatch_lowbit_bf16_mid(params);
    else moe_prefill_int8_detail::dispatch_lowbit_bf16_large(params);
  }
  return true;
}

}  // namespace ark

#elif @MOE_SOURCE_MODE@ == 15

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_prefill_int_tensor_helpers.hpp"

namespace ark {

void moe_gemm_prefill_int_dpas(sycl::queue* q, void* activations, void* weights, void* scales, void* outputs,
                               BTLA_DTYPE act_dtype, BTLA_DTYPE weight_dtype, int N, int K,
                               int* num_tokens_per_expert, int num_experts, int total_tokens) {
  if (total_tokens == 0) return;
  if (weight_dtype != BTLA_DTYPE::S8) {
    throw std::invalid_argument("moe_gemm_prefill_int_dpas: weight_dtype must be S8");
  }
  MoePrefillParams params{q, activations, weights, scales, nullptr, outputs, nullptr, act_dtype, weight_dtype, N, K,
                          0, num_tokens_per_expert, num_experts, total_tokens, false};
  const int average_tokens = num_experts > 0 ? total_tokens / num_experts : 0;
  if (act_dtype == BTLA_DTYPE::F16) {
    if (average_tokens <= 8) moe_prefill_int_tensor_detail::dispatch_f16_small(params);
    else if (average_tokens <= 32) moe_prefill_int_tensor_detail::dispatch_f16_mid(params);
    else moe_prefill_int_tensor_detail::dispatch_f16_large(params);
    return;
  }
  if (act_dtype == BTLA_DTYPE::BF16) {
    if (average_tokens <= 8) moe_prefill_int_tensor_detail::dispatch_bf16_small(params);
    else if (average_tokens <= 32) moe_prefill_int_tensor_detail::dispatch_bf16_mid(params);
    else moe_prefill_int_tensor_detail::dispatch_bf16_large(params);
    return;
  }
  throw std::invalid_argument("moe_gemm_prefill_int_dpas: act_dtype must be F16 or BF16");
}

}  // namespace ark

#elif @MOE_SOURCE_MODE@ == 16

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_prefill_s4_helpers.hpp"

namespace ark {

bool sycl_tla_moe_prefill_s4_dpas(const MoePrefillParams& params) {
  if (params.weight_dtype != BTLA_DTYPE::S4_CLIP || params.asym ||
      !moe_prefill_s4_detail::enabled() ||
      !moe_prefill_s4_detail::shape_ok(params.N, params.K, params.group_size) ||
      (params.act_dtype != BTLA_DTYPE::F16 && params.act_dtype != BTLA_DTYPE::BF16)) {
    return false;
  }
  if (params.act_dtype == BTLA_DTYPE::F16) {
    const int average_tokens = params.num_experts > 0 ? params.total_tokens / params.num_experts : 0;
    if (average_tokens <= 8) {
      moe_prefill_s4_detail::dispatch_f16_small(params);
    } else if (average_tokens <= 32) {
      moe_prefill_s4_detail::dispatch_f16_mid(params);
    } else {
      moe_prefill_s4_detail::dispatch_f16_large(params);
    }
  } else {
    const int average_tokens = params.num_experts > 0 ? params.total_tokens / params.num_experts : 0;
    if (average_tokens <= 8) {
      moe_prefill_s4_detail::dispatch_bf16_small(params);
    } else if (average_tokens <= 32) {
      moe_prefill_s4_detail::dispatch_bf16_mid(params);
    } else {
      moe_prefill_s4_detail::dispatch_bf16_large(params);
    }
  }
  return true;
}

}  // namespace ark

#elif @MOE_SOURCE_MODE@ == 17

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_prefill_fp8_native.hpp"

namespace ark {

bool sycl_tla_moe_prefill_native_fp8(const MoePrefillParams& params) {
  if ((params.weight_dtype != BTLA_DTYPE::F8_E4M3 && params.weight_dtype != BTLA_DTYPE::F8_E5M2) || params.asym ||
      !moe_prefill_native_fp8_detail::moe_prefill_native_fp8_enabled() ||
      !moe_prefill_native_fp8_detail::moe_prefill_native_fp8_shape_ok(params.N, params.K, params.group_size)) {
    return false;
  }
  const bool is_e4m3 = params.weight_dtype == BTLA_DTYPE::F8_E4M3;
  const bool use_lut = moe_dequant::fp8_decode_use_lut();
  if (params.act_dtype == BTLA_DTYPE::F16) {
    using ScalarT = sycl::half;
    if (is_e4m3) {
      if (use_lut) {
        moe_prefill_native_fp8_detail::moe_prefill_fp8_native_dispatch<ScalarT, true, true>(
            params.q, static_cast<const ScalarT*>(params.activations), static_cast<const uint8_t*>(params.weights),
            static_cast<const ScalarT*>(params.scales), static_cast<ScalarT*>(params.outputs),
            params.num_tokens_per_expert, params.num_experts, params.N, params.K, params.group_size,
            params.total_tokens);
      } else {
        moe_prefill_native_fp8_detail::moe_prefill_fp8_native_dispatch<ScalarT, true, false>(
            params.q, static_cast<const ScalarT*>(params.activations), static_cast<const uint8_t*>(params.weights),
            static_cast<const ScalarT*>(params.scales), static_cast<ScalarT*>(params.outputs),
            params.num_tokens_per_expert, params.num_experts, params.N, params.K, params.group_size,
            params.total_tokens);
      }
    } else if (use_lut) {
      moe_prefill_native_fp8_detail::moe_prefill_fp8_native_dispatch<ScalarT, false, true>(
          params.q, static_cast<const ScalarT*>(params.activations), static_cast<const uint8_t*>(params.weights),
          static_cast<const ScalarT*>(params.scales), static_cast<ScalarT*>(params.outputs),
          params.num_tokens_per_expert, params.num_experts, params.N, params.K, params.group_size,
          params.total_tokens);
    } else {
      moe_prefill_native_fp8_detail::moe_prefill_fp8_native_dispatch<ScalarT, false, false>(
          params.q, static_cast<const ScalarT*>(params.activations), static_cast<const uint8_t*>(params.weights),
          static_cast<const ScalarT*>(params.scales), static_cast<ScalarT*>(params.outputs),
          params.num_tokens_per_expert, params.num_experts, params.N, params.K, params.group_size,
          params.total_tokens);
    }
    return true;
  }
  if (params.act_dtype == BTLA_DTYPE::BF16) {
    using ScalarT = sycl::ext::oneapi::bfloat16;
    if (is_e4m3) {
      if (use_lut) {
        moe_prefill_native_fp8_detail::moe_prefill_fp8_native_dispatch<ScalarT, true, true>(
            params.q, static_cast<const ScalarT*>(params.activations), static_cast<const uint8_t*>(params.weights),
            static_cast<const ScalarT*>(params.scales), static_cast<ScalarT*>(params.outputs),
            params.num_tokens_per_expert, params.num_experts, params.N, params.K, params.group_size,
            params.total_tokens);
      } else {
        moe_prefill_native_fp8_detail::moe_prefill_fp8_native_dispatch<ScalarT, true, false>(
            params.q, static_cast<const ScalarT*>(params.activations), static_cast<const uint8_t*>(params.weights),
            static_cast<const ScalarT*>(params.scales), static_cast<ScalarT*>(params.outputs),
            params.num_tokens_per_expert, params.num_experts, params.N, params.K, params.group_size,
            params.total_tokens);
      }
    } else if (use_lut) {
      moe_prefill_native_fp8_detail::moe_prefill_fp8_native_dispatch<ScalarT, false, true>(
          params.q, static_cast<const ScalarT*>(params.activations), static_cast<const uint8_t*>(params.weights),
          static_cast<const ScalarT*>(params.scales), static_cast<ScalarT*>(params.outputs),
          params.num_tokens_per_expert, params.num_experts, params.N, params.K, params.group_size,
          params.total_tokens);
    } else {
      moe_prefill_native_fp8_detail::moe_prefill_fp8_native_dispatch<ScalarT, false, false>(
          params.q, static_cast<const ScalarT*>(params.activations), static_cast<const uint8_t*>(params.weights),
          static_cast<const ScalarT*>(params.scales), static_cast<ScalarT*>(params.outputs),
          params.num_tokens_per_expert, params.num_experts, params.N, params.K, params.group_size,
          params.total_tokens);
    }
    return true;
  }
  return false;
}

}  // namespace ark

#endif

#endif  // ARK_XPU && ARK_SYCL_TLA