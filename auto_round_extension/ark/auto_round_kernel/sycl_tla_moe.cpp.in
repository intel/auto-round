#elif @MOE_SOURCE_MODE@ == 5

#include "sycl_tla_common.hpp"
#include "sycl_tla_moe_decode.hpp"
// FP8 per-group DPAS grouped GEMM. Like the S4 decode path, the tile-policy
// instantiations live in the generated `sycl_tla_moe_prefill_fp8_*` translation
// units; this TU only needs the `dispatch_*` declarations and the env-flag /
// shape gates. Instantiating the ladder here instead would pull four cutlass
// grouped-GEMM policies x four group sizes into a single TU and push peak
// compiler RSS into the tens of GiB.
#include "sycl_tla_moe_decode_fp8_helpers.hpp"
#include "sycl_tla_moe_prefill_fp8_helpers.hpp"

namespace ark {

bool sycl_tla_moe_decode_fp8_dpas_applicable(const MoeDecodeParams& params) {
  return (params.weight_dtype == BTLA_DTYPE::F8_E4M3 || params.weight_dtype == BTLA_DTYPE::F8_E5M2) && !params.asym &&
         (params.act_dtype == BTLA_DTYPE::F16 || params.act_dtype == BTLA_DTYPE::BF16) &&
         moe_decode_dpas_fp8_enabled() &&
         moe_decode_dpas_fp8_occupancy_ok(params.total_tokens, params.num_experts) &&
         moe_prefill_fp8_detail::shape_ok(params.N, params.K, params.group_size);
}

void sycl_tla_moe_decode_fp8(const MoeDecodeParams& params) {
  if (params.act_dtype != BTLA_DTYPE::F16 && params.act_dtype != BTLA_DTYPE::BF16) {
    throw std::invalid_argument("moe_gemm_decode(fp8): act_dtype must be FP16 or BF16");
  }
  const bool is_e4m3 = params.weight_dtype == BTLA_DTYPE::F8_E4M3;

  // Fast path: FP8 through the decode-phase per-group DPAS grouped GEMM.
  // Falls back to the scalar GEMV when the env flag is off, when the batch is
  // too small to fill the DPAS M tile (the usual decode case), or when the
  // shape gate rejects the tile geometry (e.g. N%64!=0, K%32!=0, unsupported
  // group_size). Shares `sycl_tla_moe_decode_fp8_dpas_applicable` with
  // `moe_gemm_decode` (which uses it to skip the `fill_expert_id` launch) so
  // the two decisions cannot diverge.
  if (sycl_tla_moe_decode_fp8_dpas_applicable(params)) {
    const MoePrefillParams dpas_params{params.q,
                                       params.activations,
                                       params.weights,
                                       params.scales,
                                       params.zeros,
                                       params.outputs,
                                       nullptr,
                                       params.act_dtype,
                                       params.weight_dtype,
                                       params.N,
                                       params.K,
                                       params.group_size,
                                       params.num_tokens_per_expert,
                                       params.num_experts,
                                       params.total_tokens,
                                       params.asym};
    // Decode `A_avg_M` ladder (`_m_8` -> `_m_16` -> `_m_32` -> wide), matching
    // the S4 decode ladder rather than the FP8 prefill one, whose
    // `<= 512 -> m_32` rung is tuned for prefill-sized batches. The 8-row rung
    // matters because decode `A_avg_M` is far below 16, so without it half of
    // every M tile is padding and the bandwidth-bound FP8 weights are streamed
    // for rows that contribute nothing.
    const int average_tokens = params.num_experts > 0 ? params.total_tokens / params.num_experts : 0;
    if (params.act_dtype == BTLA_DTYPE::F16) {
      if (is_e4m3) {
        if (average_tokens <= 4) {
          moe_prefill_fp8_detail::dispatch_f16_e4m3_tiny(dpas_params);
        } else if (average_tokens <= 8) {
          moe_prefill_fp8_detail::dispatch_f16_e4m3_small(dpas_params);
        } else if (average_tokens <= 128) {
          moe_prefill_fp8_detail::dispatch_f16_e4m3_mid(dpas_params);
        } else {
          moe_prefill_fp8_detail::dispatch_f16_e4m3_large(dpas_params);
        }
      } else if (average_tokens <= 4) {
        moe_prefill_fp8_detail::dispatch_f16_e5m2_tiny(dpas_params);
      } else if (average_tokens <= 8) {
        moe_prefill_fp8_detail::dispatch_f16_e5m2_small(dpas_params);
      } else if (average_tokens <= 128) {
        moe_prefill_fp8_detail::dispatch_f16_e5m2_mid(dpas_params);
      } else {
        moe_prefill_fp8_detail::dispatch_f16_e5m2_large(dpas_params);
      }
    } else if (is_e4m3) {
      if (average_tokens <= 4) {
        moe_prefill_fp8_detail::dispatch_bf16_e4m3_tiny(dpas_params);
      } else if (average_tokens <= 8) {
        moe_prefill_fp8_detail::dispatch_bf16_e4m3_small(dpas_params);
      } else if (average_tokens <= 128) {
        moe_prefill_fp8_detail::dispatch_bf16_e4m3_mid(dpas_params);
      } else {
        moe_prefill_fp8_detail::dispatch_bf16_e4m3_large(dpas_params);
      }
    } else if (average_tokens <= 4) {
      moe_prefill_fp8_detail::dispatch_bf16_e5m2_tiny(dpas_params);
    } else if (average_tokens <= 8) {
      moe_prefill_fp8_detail::dispatch_bf16_e5m2_small(dpas_params);
    } else if (average_tokens <= 128) {
      moe_prefill_fp8_detail::dispatch_bf16_e5m2_mid(dpas_params);
    } else {
      moe_prefill_fp8_detail::dispatch_bf16_e5m2_large(dpas_params);
    }
    return;
  }

  // Scalar GEMV fallback. The kernels are not instantiated here: each
  // (dtype, format, decode-mode) triple lives in its own generated
  // `sycl_tla_moe_decode_fp8_*` translation unit, so this TU instantiates no
  // SYCL kernels at all. Expanding them inline means 2 dtypes x 2 formats x 3
  // modes x 4 kernels = 48 kernels in one TU, which measured ~14.4 GiB of peak
  // compiler RSS. `fp8_decode_mode()` (`ARK_FP8_DECODE_MODE`) picks the
  // byte-decode mode on the host exactly as `launch_fp8_by_mode` used to; the
  // K-split vs legacy choice still happens inside the selected TU. All
  // variants are numerically equivalent.
  const moe_dequant::Fp8DecodeMode decode_mode = moe_dequant::fp8_decode_mode();
  if (params.act_dtype == BTLA_DTYPE::F16) {
    if (is_e4m3) {
      switch (decode_mode) {
        case moe_dequant::Fp8DecodeMode::kLut:
          moe_decode_fp8_detail::dispatch_f16_e4m3_lut(params);
          return;
        case moe_dequant::Fp8DecodeMode::kBits:
          moe_decode_fp8_detail::dispatch_f16_e4m3_bits(params);
          return;
        default:
          moe_decode_fp8_detail::dispatch_f16_e4m3_word(params);
          return;
      }
    }
    switch (decode_mode) {
      case moe_dequant::Fp8DecodeMode::kLut:
        moe_decode_fp8_detail::dispatch_f16_e5m2_lut(params);
        return;
      case moe_dequant::Fp8DecodeMode::kBits:
        moe_decode_fp8_detail::dispatch_f16_e5m2_bits(params);
        return;
      default:
        moe_decode_fp8_detail::dispatch_f16_e5m2_word(params);
        return;
    }
  }
  if (is_e4m3) {
    switch (decode_mode) {
      case moe_dequant::Fp8DecodeMode::kLut:
        moe_decode_fp8_detail::dispatch_bf16_e4m3_lut(params);
        return;
      case moe_dequant::Fp8DecodeMode::kBits:
        moe_decode_fp8_detail::dispatch_bf16_e4m3_bits(params);
        return;
      default:
        moe_decode_fp8_detail::dispatch_bf16_e4m3_word(params);
        return;
    }
  }
  switch (decode_mode) {
    case moe_dequant::Fp8DecodeMode::kLut:
      moe_decode_fp8_detail::dispatch_bf16_e5m2_lut(params);
      return;
    case moe_dequant::Fp8DecodeMode::kBits:
      moe_decode_fp8_detail::dispatch_bf16_e5m2_bits(params);
      return;
    default:
      moe_decode_fp8_detail::dispatch_bf16_e5m2_word(params);
      return;
  }
}

}  // namespace ark

