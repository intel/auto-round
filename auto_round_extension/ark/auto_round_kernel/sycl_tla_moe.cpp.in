  const int average_tokens = num_experts > 0 ? total_tokens / num_experts : 0;
  const bool is_e4m3 = weight_dtype == BTLA_DTYPE::F8_E4M3;
  if (act_dtype == BTLA_DTYPE::F16) {
    if (is_e4m3) {
      if (average_tokens <= 8) moe_prefill_fp8_tensor_detail::dispatch_f16_e4m3_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_tensor_detail::dispatch_f16_e4m3_mid(params);
      else moe_prefill_fp8_tensor_detail::dispatch_f16_e4m3_large(params);
    } else {
      if (average_tokens <= 8) moe_prefill_fp8_tensor_detail::dispatch_f16_e5m2_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_tensor_detail::dispatch_f16_e5m2_mid(params);
      else moe_prefill_fp8_tensor_detail::dispatch_f16_e5m2_large(params);
    }
    return;
  }
  if (act_dtype == BTLA_DTYPE::BF16) {
    if (is_e4m3) {
      if (average_tokens <= 8) moe_prefill_fp8_tensor_detail::dispatch_bf16_e4m3_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_tensor_detail::dispatch_bf16_e4m3_mid(params);
      else moe_prefill_fp8_tensor_detail::dispatch_bf16_e4m3_large(params);
    } else {
      if (average_tokens <= 8) moe_prefill_fp8_tensor_detail::dispatch_bf16_e5m2_small(params);
      else if (average_tokens <= 32) moe_prefill_fp8_tensor_detail::dispatch_bf16_e5m2_mid(params);
      else moe_prefill_fp8_tensor_detail::dispatch_bf16_e5m2_large(params);
    }
    return;
  }
  throw std::invalid_argument("moe_gemm_prefill_fp8_dpas: act_dtype must be F16 or BF16");
