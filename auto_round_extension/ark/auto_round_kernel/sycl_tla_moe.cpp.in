void sycl_tla_moe_decode_fill_expert_id(sycl::queue* q, int* expert_id_per_token,
                                        const int* num_tokens_per_expert, int num_experts, int total_tokens) {
  if (total_tokens == 0) return;
  q->parallel_for(sycl::range<1>(static_cast<size_t>(total_tokens)), [=](sycl::id<1> idx) {
    const int token = static_cast<int>(idx[0]);
    int offset = 0;
    int expert = num_experts - 1;
    for (int expert_id = 0; expert_id < num_experts; ++expert_id) {
      const int token_count = num_tokens_per_expert[expert_id];
      if (token < offset + token_count) {
        expert = expert_id;
        break;
      }
      offset += token_count;
    }
    expert_id_per_token[token] = expert;
  });
}

void moe_gemm_decode(sycl::queue* q, void* activations, void* weights, void* scales, void* zeros, void* outputs,
                     int* expert_id_per_token_buf, BTLA_DTYPE act_dtype, BTLA_DTYPE weight_dtype, int N, int K,
                     int group_size, int* num_tokens_per_expert, int num_experts, int total_tokens, bool asym) {
  MoeDecodeParams params{q, activations, weights, scales, zeros, outputs, expert_id_per_token_buf, act_dtype,
                         weight_dtype, N, K, group_size, num_tokens_per_expert, num_experts, total_tokens, asym};

  // The int4-sym and FP8 DPAS fast paths consume `num_tokens_per_expert`
  // directly and never read `expert_id_per_token_buf`. Skipping the fill on
  // those paths removes an extra device-timeline kernel launch from the decode
  // hot path; every other path (fp, int8, int2, and the scalar int4 / fp8
  // fallbacks) still needs the per-token expert mapping.
  const bool dpas_fastpath =
      (weight_dtype == BTLA_DTYPE::S4_CLIP && sycl_tla_moe_decode_int4_dpas_applicable(params)) ||
      ((weight_dtype == BTLA_DTYPE::F8_E4M3 || weight_dtype == BTLA_DTYPE::F8_E5M2) &&
       sycl_tla_moe_decode_fp8_dpas_applicable(params));
  if (!dpas_fastpath) {
    sycl_tla_moe_decode_fill_expert_id(q, expert_id_per_token_buf, num_tokens_per_expert, num_experts, total_tokens);
  }

  if (weight_dtype == BTLA_DTYPE::F16 || weight_dtype == BTLA_DTYPE::BF16) {
    if (weight_dtype != act_dtype) {
      throw std::invalid_argument("moe_gemm_decode: unquantized weight_dtype must match act_dtype");
    }
    sycl_tla_moe_decode_fp(params);
    return;
  }
  if (weight_dtype == BTLA_DTYPE::S4_CLIP) {
    sycl_tla_moe_decode_int4(params);
    return;
  }
  if (weight_dtype == BTLA_DTYPE::S8) {
    sycl_tla_moe_decode_int8(params);
    return;
  }
  if (weight_dtype == BTLA_DTYPE::S2_CLIP) {
    sycl_tla_moe_decode_int2(params);
    return;
  }
  if (weight_dtype == BTLA_DTYPE::F8_E4M3 || weight_dtype == BTLA_DTYPE::F8_E5M2) {
    if (asym) {
      throw std::invalid_argument("moe_gemm_decode(fp8): asym mode is not supported");
    }
    sycl_tla_moe_decode_fp8(params);
    return;
  }
  throw std::invalid_argument(
      "moe_gemm_decode: unsupported weight_dtype (supported: F16, BF16, S8, S4_CLIP, S2_CLIP, F8_E4M3, F8_E5M2)");
}

