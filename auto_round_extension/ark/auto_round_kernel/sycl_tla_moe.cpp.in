void @MOE_FUNCTION_NAME@(const MoePrefillParams& params) {
  using ScalarT = @MOE_SCALAR_TYPE@;
  @MOE_DPAS_NAMESPACE@::@MOE_DISPATCH_FUNCTION@<ScalarT, @MOE_POLICY_ARGS@>(
      params.q, static_cast<const ScalarT*>(params.activations),
      static_cast<const @MOE_WEIGHT_TYPE@*>(params.weights), static_cast<const ScalarT*>(params.scales),
      static_cast<ScalarT*>(params.outputs), params.num_tokens_per_expert, params.num_experts, params.N, params.K,
      params.group_size, params.total_tokens);
}

}  // namespace @MOE_NAMESPACE@
